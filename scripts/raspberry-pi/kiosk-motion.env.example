# Copy to Pi: sudo cp kiosk-motion.env.example /etc/kiosk-motion.env
# sudo chmod 600 /etc/kiosk-motion.env
#
# Service role key: Supabase Dashboard -> Project Settings -> API -> service_role
# Never commit the real file. Do not put service_role in the browser .env.

SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_secret
KIOSK_ID=demo
MOTION_GPIO_PIN=17
COOLDOWN_SEC=3
MOTION_DEBUG=1
