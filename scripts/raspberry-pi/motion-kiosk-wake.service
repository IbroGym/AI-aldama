# Copy to /etc/systemd/system/motion-kiosk-wake.service
# Secrets in /etc/kiosk-motion.env (chmod 600, root:root):
#   SUPABASE_URL=...
#   SUPABASE_SERVICE_ROLE_KEY=...
#   KIOSK_ID=demo
#
# sudo systemctl daemon-reload
# sudo systemctl enable --now motion-kiosk-wake.service

[Unit]
Description=HC-SR501 motion -> Supabase kiosk wake
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=-/etc/kiosk-motion.env
ExecStart=/usr/bin/python3 /opt/kiosk-motion/motion_kiosk_wake.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
